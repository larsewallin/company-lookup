# Copy to .env (server.js reads it) or set in your Vercel project. All are optional.

# Identify your app to the registers. SEC EDGAR requires a contact e-mail address.
COMPANY_LOOKUP_USER_AGENT=YourCompany credit-tools (you@example.com)

# UK Companies House: free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Singapore data.gov.sg: optional key for higher rate limits
DATA_GOV_SG_API_KEY=

# Vercel Blob read-write token, for the hosted-index countries when running outside Vercel (see README)
BLOB_READ_WRITE_TOKEN=

# API keys for trusted callers of /v1/: name:sha256hash pairs, comma-separated. Make them with
# `node scripts/new-api-key.js <name>`. Only the hash goes here, never the key itself.
COMPANY_LOOKUP_API_KEYS=
# Requests per 5 minutes for each keyed caller (default 400)
COMPANY_LOOKUP_KEY_RATE_LIMIT=
# Base URL for links in v1 responses (default: the address the request came to)
COMPANY_LOOKUP_PUBLIC_URL=
