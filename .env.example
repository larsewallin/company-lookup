# Copy to .env (server.js reads it) or set in your Vercel project. All are optional.

# Identify your app to the registers. SEC EDGAR requires a contact e-mail address.
COMPANY_LOOKUP_USER_AGENT=YourCompany credit-tools (you@example.com)

# UK Companies House: free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Singapore data.gov.sg: optional key for higher rate limits
DATA_GOV_SG_API_KEY=

# Vercel Blob read-write token, for the hosted-index countries (see README)
BLOB_READ_WRITE_TOKEN=
